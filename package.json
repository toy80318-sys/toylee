{
  "name": "toylee",
  "version": "1.0.0",
  "private": true,
  "description": "교보생명 평생든든 서비스 고객 정보파악(Fact-Finding) 프로그램",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "template": "node scripts/make-template.js",
    "build:tablet": "node scripts/build-standalone.js",
    "build:web": "node scripts/build-pages.js",
    "build:new": "node scripts/build-newcust.js",
    "icons:rabbit": "node scripts/make-rabbit-icons.js",
    "vendor:sdk": "esbuild scripts/anthropic-entry.js --bundle --format=iife --global-name=AnthropicSDK --platform=browser --target=es2020 --minify --alias:node:fs=./scripts/browser-stub/node-fs.js --alias:node:path=./scripts/browser-stub/node-path.js --outfile=standalone/anthropic-sdk.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "multer": "^2.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "esbuild": "^0.27.0"
  }
}
